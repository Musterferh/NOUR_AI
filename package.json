{
  "name": "nour",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "db:restore": "node --env-file-if-exists=.env.local scripts/restore.mjs",
    "knowledge:build": "node scripts/generate-embeddings.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "0.8.1",
    "@prisma/client": "5.22.0",
    "@prisma/adapter-libsql": "^5.22.0",
    "@tailwindcss/typography": "^0.5.20",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "openai": "^7.20.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "tsx": "^4.20.0"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.3.5",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "engines": { "node": ">=22.16.0" }
}
