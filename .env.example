# Private study access. npm run setup generates unique values in .env.local.
APP_ACCESS_PASSWORD=
AUTH_SECRET=
# Set this to your exact public HTTPS origin when deploying behind a proxy.
# APP_ORIGIN=https://your-private-app.example

# Core coaching. Use a model enabled in your Moonshot account.
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-128k
# KIMI_BASE_URL=https://api.moonshot.ai/v1/chat/completions

# Optional voice. Text coaching works without this key.
OPENAI_API_KEY=

# Local SQLite, relative to prisma/. For Turso use libsql://... and its token.
DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# Combined daily cap for chat, exam, transcription and speech requests.
DAILY_AI_REQUEST_LIMIT=300
